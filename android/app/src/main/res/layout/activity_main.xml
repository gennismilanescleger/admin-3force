<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ============ LOGIN (WebView del panel real) ============ -->
    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btnBackToSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button_ghost"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="← Volver a la sesión"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin 3FORCE"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="reseller.3forcevpn.com"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/loginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/amber"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ============ BLOQUEO (biometría / credencial) ============ -->
    <LinearLayout
        android:id="@+id/lockContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin 3FORCE"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sesión guardada"
            android:textColor="@color/greenSoft"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Desbloquea con la huella o el rostro ya registrados en tu teléfono, o con tu PIN/patrón, para continuar."
            android:textColor="@color/text2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lockStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/amber"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_button_primary"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="Desbloquear"
            android:textAllCaps="false"
            android:textColor="@color/onCyan"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLockLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_ghost"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Cerrar sesión y entrar de nuevo"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ============ SESIÓN (solo datos reales del token) ============ -->
    <ScrollView
        android:id="@+id/sessionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin 3FORCE"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Sesión activa"
                    android:textColor="@color/greenSoft"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/claimsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:text="Abrir panel"
                android:textAllCaps="false"
                android:textColor="@color/onCyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_ghost"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="@color/redSoft"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
